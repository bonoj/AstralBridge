{
  "id": "./",
  "name": "AstralBridge Intake",
  "short_name": "Bridge Intake",
  "description": "Receive selected text and original files for the AstralBridge transport experiment.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f3ed",
  "theme_color": "#245f51",
  "icons": [
    {"src":"./icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},
    {"src":"./icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"}
  ],
  "share_target": {
    "action": "./capture",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"title":"title","text":"text","url":"url","files":[{"name":"files","accept":["*/*",".txt",".md",".json",".csv",".tsv",".html",".js",".pdf",".png",".jpg",".jpeg",".webp",".zip"]}]}
  }
}
